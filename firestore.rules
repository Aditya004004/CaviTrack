rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true && request.appCheck.token != null;
    }

    function isOwner(data) {
      return isAuthenticated() && data.ownerId == request.auth.uid;
    }

    function isOwnerCreating(data) {
      return isAuthenticated() && data.ownerId == request.auth.uid;
    }

    function isValidComponent(data) {
      return data.keys().hasAll(['name', 'sku', 'category', 'qty', 'unit', 'ownerId'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.sku is string
        && data.qty is int && data.qty >= 0
        && data.minStockThreshold is int && data.minStockThreshold >= 0
        && data.isDeleted == false;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone', 'email', 'address', 'ownerId'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string
        && data.phone is string
        && data.isDeleted == false;
    }

    function isValidMold(data) {
      return data.keys().hasAll(['moldCode', 'cavityCount', 'status', 'location', 'ownerId'])
        && data.moldCode is string && data.moldCode.size() > 0
        && data.cavityCount is int && data.cavityCount > 0
        && data.status is string
        && data.isDeleted == false;
    }

    function isValidHistoryLog(data) {
      return data.keys().hasAll(['entityType', 'entityId', 'entityName', 'action', 'timestamp', 'ownerId'])
        && data.entityType is string
        && data.entityId is string
        && data.action is string
        && data.timestamp is int;
    }

    match /components/{documentId} {
      allow read: if isOwner(resource.data);
      allow create: if isOwnerCreating(request.resource.data) && isValidComponent(request.resource.data);
      allow update: if isOwner(resource.data) && isOwnerCreating(request.resource.data) && isValidComponent(request.resource.data);
      allow delete: if isOwner(resource.data);
    }

    match /customers/{documentId} {
      allow read: if isOwner(resource.data);
      allow create: if isOwnerCreating(request.resource.data) && isValidCustomer(request.resource.data);
      allow update: if isOwner(resource.data) && isOwnerCreating(request.resource.data) && isValidCustomer(request.resource.data);
      allow delete: if isOwner(resource.data);
    }

    match /molds/{documentId} {
      allow read: if isOwner(resource.data);
      allow create: if isOwnerCreating(request.resource.data) && isValidMold(request.resource.data);
      allow update: if isOwner(resource.data) && isOwnerCreating(request.resource.data) && isValidMold(request.resource.data);
      allow delete: if isOwner(resource.data);
    }

    // History is an append-only audit trail
    match /history/{documentId} {
      allow read: if isOwner(resource.data);
      allow create: if isOwnerCreating(request.resource.data) && isValidHistoryLog(request.resource.data);
      allow update, delete: if false;
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
